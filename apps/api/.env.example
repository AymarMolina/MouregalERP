# Copia este archivo como ".env" en apps/api y completa los valores reales.
# NUNCA subas el ".env" real a git (debe estar en .gitignore).

# --- Base de datos (Neon) ---
# Conexión pooled: la usa la app en runtime (NestJS/Drizzle).
DATABASE_URL=postgres://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/erp?sslmode=require
# Conexión unpooled: la usa drizzle-kit para generar/correr migraciones.
DATABASE_URL_UNPOOLED=postgres://usuario:password@ep-xxxx.region.aws.neon.tech/erp?sslmode=require

# --- Auth (JWT) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- General ---
TZ=America/Lima
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS, separados por coma (obligatorio en producción).
CORS_ORIGIN=http://localhost:4200
# true si el API corre detrás de un proxy/balanceador (para el rate limit del login).
TRUST_PROXY=false

# --- Pagos / despacho ---
# Base de los links de pago (stub hasta integrar la pasarela).
PAGOS_LINK_BASE=https://pagos.mouregal.pe/stub
# Permite marcar "entregado" un pedido con saldo pendiente (queda advertencia en el historial).
PERMITIR_ENTREGA_CON_SALDO=false
